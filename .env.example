# Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# Postgres connection string
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/linkedin_leads

# Text search mode (optional if using COMPANIES or --queries)
SEARCH_QUERIES=Senior HR Manager in Dhaka

# Company mode (optional; takes precedence over SEARCH_QUERIES)
COMPANIES=

# Direct profile URLs to enrich (optional; requires ENRICH_PROFILES=true)
PROFILES=

MAX_LEADS=100
MAX_BUDGET_USD=5.00

# Enrichment (email/phone via dev_fusion actor). Set false on free plans.
ENRICH_PROFILES=true

# Optional location filters
FILTER_COUNTRY=BD
FILTER_CITY=
